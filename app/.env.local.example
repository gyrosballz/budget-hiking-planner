# MongoDB Connection String
# For local development, MongoDB should be running on localhost:27017
# You can install MongoDB locally or use MongoDB Atlas (cloud service)

# Local MongoDB Example:
MONGODB_URI=mongodb://localhost:27017/budget-hiking-planner

# MongoDB Atlas Cloud Example (uncomment and replace with your connection string):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/budget-hiking-planner?retryWrites=true&w=majority

# To use this file:
# 1. Copy this file to .env.local
# 2. Update MONGODB_URI with your actual MongoDB connection string
# 3. Restart the development server (npm run dev)
